# Replace placeholders. Do not copy over an existing .env or commit real secrets.
# To exclude this file entirely, set DJANGO_LOAD_DOTENV=false in the process environment.
DJANGO_SECRET_KEY=replace-with-a-random-production-secret-of-at-least-50-characters
DJANGO_DEBUG=false
# Required in production. Explicitly include your hosting/custom domains.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated https:// origins, only for trusted cross-origin forms if needed.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Defaults: true when DEBUG=false, false when DEBUG=true.
# Leave commented for local DJANGO_DEBUG=true to use those defaults.
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# Enable only after verifying TLS termination and proxy header sanitization.
DJANGO_TRUST_PROXY_SSL_HEADER=false
# For login throttle IPs: 0 ignores X-Forwarded-For. Set exact trusted hops only after proxy review.
DJANGO_THROTTLE_NUM_PROXIES=0
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

POSTGRES_DB=crmserver
POSTGRES_USER=crmserver
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=0
POSTGRES_CONN_HEALTH_CHECKS=true
# Empty preserves libpq defaults. Select the provider's TLS mode/certificate.
POSTGRES_SSLMODE=
POSTGRES_SSLROOTCERT=

OBSERVABILITY_ENABLED=true
OBSERVABILITY_HTTP_SAMPLE_RATE=1
OBSERVABILITY_SQL_ENABLED=false
OBSERVABILITY_SQL_SAMPLE_RATE=0.1
OBSERVABILITY_SYNC_ENABLED=true
# Excludes only successful HTTP events by route name; sync events are independent.
OBSERVABILITY_EXCLUDE_ROUTES=healthz,app-update,static

# Optional: only when explicitly starting with gunicorn -c gunicorn.conf.py.
# Container platforms may require 0.0.0.0:<assigned port> in process environment.
# GUNICORN_BIND=127.0.0.1:8000
# WEB_CONCURRENCY=1
# GUNICORN_TIMEOUT=30
